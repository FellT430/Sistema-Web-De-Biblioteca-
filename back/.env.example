# ---------- Aplicação ----------
SECRET_KEY=${SECRET_KEY}
FLASK_DEBUG=${FLASK_DEBUG:-False}

# ---------- Banco de dados ----------
DATABASE_URL=${DATABASE_URL}

# ---------- Administradores do sistema (super admin) ----------
# Os e-mails ficam no código (config.py -> SUPERADMINS); aqui vai só a senha.
# A conta é criada automaticamente quando o sistema inicia.
SUPERADMIN_BRUNO_SENHA=${SUPERADMIN_BRUNO_SENHA}
SUPERADMIN_FELIPE_SENHA=${SUPERADMIN_FELIPE_SENHA}

# ---------- Google Books ----------
# Opcional; sem chave a API funciona, mas com limite menor de requisições
GOOGLE_BOOKS_API_KEY=${GOOGLE_BOOKS_API_KEY:-}

# ---------- LGPD ----------
CONTATO_EMAIL=${CONTATO_EMAIL:-contato@livromais.com}
