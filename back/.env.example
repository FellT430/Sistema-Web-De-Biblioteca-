# ---------- Aplicação ----------
SECRET_KEY=${SECRET_KEY}
FLASK_DEBUG=${FLASK_DEBUG:-False}

# ---------- Banco de dados ----------
DATABASE_URL=${DATABASE_URL}

# ---------- Administradores do sistema (super admin) ----------
# Os e-mails ficam no código (config.py -> SUPERADMINS); aqui vai só a senha.
# A conta é criada automaticamente quando o sistema inicia.
SUPERADMIN_BRUNO_SENHA=${SUPERADMIN_BRUNO_SENHA}
SUPERADMIN_FELIPE_SENHA=${SUPERADMIN_FELIPE_SENHA}

# ---------- Google Books ----------
# Opcional; sem chave a API funciona, mas com limite menor de requisições
GOOGLE_BOOKS_API_KEY=${GOOGLE_BOOKS_API_KEY:-}

# ---------- LGPD ----------
CONTATO_EMAIL=${CONTATO_EMAIL:-contato@livromais.com}

# ---------- E-mail (confirmação de cadastro e avisos) ----------
# Testes: credenciais da caixa de teste do Mailtrap (Email Testing > SMTP).
# Sem MAIL_SERVER, o sistema não envia e mostra o e-mail no terminal.
MAIL_SERVER=${MAIL_SERVER:-}
MAIL_PORT=${MAIL_PORT:-2525}
MAIL_USE_TLS=${MAIL_USE_TLS:-True}
MAIL_USERNAME=${MAIL_USERNAME:-}
MAIL_PASSWORD=${MAIL_PASSWORD:-}
MAIL_DEFAULT_SENDER=${MAIL_DEFAULT_SENDER:-nao-responda@livromais.com}

# ---------- Endereço do site (links nos e-mails do agendador) ----------
APP_URL=${APP_URL:-http://127.0.0.1:5000}
